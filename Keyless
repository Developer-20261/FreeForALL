local Players = game:GetService("Players")
local SetClipboard = setclipboard or toclipboard or (http and http.setclipboard)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--==================================================
-- REMOVE OLD UI
--==================================================

local oldUI = playerGui:FindFirstChild("ShadowBlockedUI")

if oldUI then
	oldUI:Destroy()
end

